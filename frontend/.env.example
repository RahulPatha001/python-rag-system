# Browser API base. Keep /api for local development so Vite can proxy requests.
VITE_API_BASE_URL=/api

# Optional endpoint overrides. Paths are appended to VITE_API_BASE_URL.
VITE_UPLOAD_ENDPOINT=/upload
VITE_QUERY_ENDPOINT=/query
VITE_HEALTH_ENDPOINT=/health

# Vite-only development setting. It is not exposed in the production bundle.
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
